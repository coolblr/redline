# OpenRouter API key used by lib/openrouter.ts for every model call.
OPENROUTER_API_KEY=

# Model id passed to OpenRouter on every request (e.g. a provider/model slug). Never hardcoded in code.
OPENROUTER_MODEL=

# Supabase project URL, from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key, from the project's API settings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
